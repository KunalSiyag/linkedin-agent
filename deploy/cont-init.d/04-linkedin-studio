#!/command/with-contenv sh
# Installs the linkedin-studio skill, persona and schedules on every boot.
# Skills come from the public repo (latest main, so updates need only a push and a restart), falling back to the
# copy baked into the image. Personal files (profile/) are never in the repo; they live in $LINKEDIN_HOME/profile.
set -u
ENVDIR=/run/s6/container_environment
HH="${HERMES_HOME:-/opt/data}"
REPO="${LINKEDIN_AGENT_REPO:-KunalSiyag/linkedin-agent}"
REF="${LINKEDIN_AGENT_REF:-main}"
LIVE="$HH/linkedin-agent"
BAKED=/opt/linkedin-agent
LH="${LINKEDIN_HOME:-$HH/linkedin}"

setenv() { [ -n "$(printenv "$1" 2>/dev/null)" ] || printf '%s' "$2" > "$ENVDIR/$1"; }
as_hermes() { s6-setuidgid hermes env HOME="$HH" HERMES_HOME="$HH" "$@"; }
hermes() { as_hermes /opt/hermes/.venv/bin/hermes "$@"; }

setenv LINKEDIN_HOME "$LH"
setenv GITHUB_USER "${REPO%%/*}"
# Answer in the home channel without an @mention.
[ -n "${DISCORD_HOME_CHANNEL:-}" ] && setenv DISCORD_FREE_RESPONSE_CHANNELS "$DISCORD_HOME_CHANNEL"

# The checkout is owned by root and read-only to the agent (hermes), so the agent can't edit its own guardrails.
if [ "${LINKEDIN_AGENT_SYNC:-true}" = "true" ]; then
  if [ -d "$LIVE/.git" ]; then
    chown -R root:root "$LIVE"
    git -C "$LIVE" fetch -q --depth 1 origin "$REF" && git -C "$LIVE" reset -q --hard FETCH_HEAD \
      || echo "[linkedin-studio] git update failed; keeping the existing checkout"
  else
    git clone -q --depth 1 --branch "$REF" "https://github.com/$REPO.git" "$LIVE" \
      || echo "[linkedin-studio] git clone failed; using the baked copy"
  fi
fi
[ -d "$LIVE" ] && chown -R root:root "$LIVE" && chmod -R a+rX,go-w "$LIVE"
SRC="$BAKED"
[ -f "$LIVE/skills/linkedin-studio/SKILL.md" ] && SRC="$LIVE"
echo "[linkedin-studio] skills from $SRC ($(git -C "$SRC" rev-parse --short HEAD 2>/dev/null || echo baked))"

as_hermes mkdir -p "$LH/profile" "$LH/drafts" "$LH/facts" "$LH/state" "$LH/tmp" "$LH/hackathons"
# Model lab: the agent queues jobs; only gmilab (the gmi-lab service) writes results, prices and the spend ledger.
mkdir -p "$LH/lab/queue" "$LH/lab/results" "$LH/lab/shared" "$LH/lab/state"
chown root:root "$LH/lab" && chmod 755 "$LH/lab"
chown hermes:hermes "$LH/lab/queue"
id gmilab >/dev/null 2>&1 && chown -R gmilab:gmilab "$LH/lab/results" "$LH/lab/shared" "$LH/lab/state"
chmod 755 "$LH/lab/queue" "$LH/lab/results" "$LH/lab/shared" "$LH/lab/state"
cp "$SRC/deploy/SOUL.md" "$HH/SOUL.md" && chown root:root "$HH/SOUL.md" && chmod 644 "$HH/SOUL.md"
# The guardrail lists are root-owned too: change them from the console, not through the agent.
for f in blocklist.txt never_name.txt sponsors.txt studio.json; do
  [ -f "$LH/profile/$f" ] && chown root:root "$LH/profile/$f" && chmod 644 "$LH/profile/$f"
done
hermes config set skills.external_dirs "[\"$SRC/skills\"]" >/dev/null
hermes config set timezone "${HERMES_TIMEZONE:-Asia/Kolkata}" >/dev/null
# Models per role: profile/studio.json overrides the defaults. The critic runs as a delegated subagent, so
# delegation.model is the critic; it inherits the gmi provider and credentials from the parent.
model_for() {
  /opt/hermes/.venv/bin/python -c 'import json,sys; print(json.load(open(sys.argv[1])).get("models",{}).get(sys.argv[2],""))' \
    "$LH/profile/studio.json" "$1" 2>/dev/null
}
CRITIC="$(model_for critic)"; CRITIC="${CRITIC:-${STUDIO_CRITIC_MODEL:-google/gemini-3.8-flash}}"
DIGEST="$(model_for digest)"; DIGEST="${DIGEST:-${STUDIO_DIGEST_MODEL:-deepseek-ai/DeepSeek-V4-Flash}}"
hermes config set delegation.model "$CRITIC" >/dev/null && echo "[linkedin-studio] critic (delegation.model): $CRITIC"
# Voice notes in Discord are transcribed locally (free, nothing leaves the box); the model unloads after 5 idle minutes.
hermes config set stt.provider local >/dev/null
hermes config set stt.local.model "${STUDIO_STT_MODEL:-small}" >/dev/null
hermes config set stt.local.unload_after_idle_seconds 300 >/dev/null
[ -f "$LH/profile/blocklist.txt" ] || echo "[linkedin-studio] WARNING: $LH/profile is empty; drafts are blocked until it is set up"

# Schedules (created once; edit or pause them from Discord or `hermes cron`).
ensure_job() {  # name schedule prompt [model]
  if hermes cron list --all 2>/dev/null | grep -q "Name: *$1\$"; then return; fi
  for try in 1 2 3; do
    if out="$(hermes cron create --name "$1" --skill linkedin-studio --deliver discord ${4:+--model "$4" --provider gmi} "$2" "$3" 2>&1)"; then
      echo "[linkedin-studio] cron: created $1 ($2)"; return
    fi
    sleep 2
  done
  echo "[linkedin-studio] cron: could not create $1: $(echo "$out" | grep -v WARNING | tail -n 2)"
}
if [ "${LINKEDIN_STUDIO_CRON:-true}" = "true" ]; then
  ensure_job linkedin-morning-digest "0 8 * * *" "Run the linkedin-studio morning digest and post it." "$DIGEST"
  ensure_job linkedin-weekly-plan "0 9 * * 1" "Run the linkedin-studio weekly plan: propose this week's 3 posts as angles."
  ensure_job linkedin-opportunities "0 10 * * 6" "Run the linkedin-studio weekly opportunities list and post it." "$DIGEST"
fi
