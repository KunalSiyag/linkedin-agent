#!/command/with-contenv sh
# Refreshes $LINKEDIN_HOME/state/gmi_catalog.json every 6 hours for the morning digest's "new on GMI" section.
# Runs outside the agent with the image's read-only copy of the script, so the GMI key never enters a process
# the agent controls and the agent can't change what runs with it.
LH="${LINKEDIN_HOME:-${HERMES_HOME:-/opt/data}/linkedin}"
while :; do
  s6-setuidgid hermes env LINKEDIN_HOME="$LH" /opt/hermes/.venv/bin/python \
    /opt/linkedin-agent/skills/linkedin-studio/scripts/sources.py gmi-catalog 2>&1 | sed 's/^/[gmi-catalog] /'
  sleep 21600
done
