# Agentbox environment for the LinkedIn Post Agent (Hermes on GMI Agentbox).
# Copy to agentbox.env.local (git-ignored) for your own values. SECRET values go only into the
# Agentbox console form; never commit them.

# --- Discord ---
DISCORD_BOT_TOKEN=            # SECRET: Developer Portal > Bot > Reset Token
DISCORD_ALLOWED_USERS=        # your Discord user ID (Developer Mode > right-click yourself > Copy User ID)
DISCORD_HOME_CHANNEL=         # channel ID where drafts are posted (e.g. #drafts)

# --- Hermes API server (exposed by Agentbox on 443 -> 8080) ---
API_SERVER_KEY=               # SECRET: generate with `openssl rand -hex 32`
# API_SERVER_ENABLED/HOST/PORT are baked into the image (deploy/Dockerfile).

# --- Model ---
# Turn MaaS integration ON: Agentbox injects GMI_MAAS_API_KEY, which
# deploy/cont-init.d/03-agentbox-config aliases to GMI_API_KEY for Hermes.
HERMES_MODEL=deepseek-ai/DeepSeek-V4-Pro

# --- Your profile (the box's disk resets on restart, so it lives here; rewritten on every boot) ---
# Lists take "," or ";" between items. Free text takes "\n" for a new line. Format: profile.example/.
LINKEDIN_BLOCKLIST=           # SECRET, required: employer, its products, clients, colleagues. No drafts without it.
LINKEDIN_NEVER_NAME=          # brands/relationships never named on LinkedIn, e.g. GMI Cloud, GMI, Agentbox, ambassador
LINKEDIN_ABOUT=               # who you are, what you build, your audience (the bot asks in Discord if empty)
LINKEDIN_VOICE=               # how you write, with an example line (the bot asks in Discord if empty)
LINKEDIN_SPONSORS=            # paid partners only, ";" between entries: Brand | #ad, paid partnership
LINKEDIN_EXCLUDE_REPOS=       # public repos never used as post material
LINKEDIN_STUDIO=              # optional JSON: models, visuals footer/accent, lab and video budgets (profile.example/studio.json)
                              # explainer videos with AI B-roll: {"video": {"ai_clips": true, "media_daily_usd": 6}} (~$5 a video)

# --- Do NOT set ---
# GATEWAY_ALLOW_ALL_USERS=true   (would let anyone in the server command the agent)
